# DOC-E-BE §Y — Variables del backend. Copie a .env (ignorado por git). Nunca versione secretos reales.
# Obligatorio. Si se omite se asume `production` (exige secretos reales y COOKIE_SECURE=true). Use `development` solo en local.
NODE_ENV=development
PORT=3000
# Prefijo de la API (ADR-002). El FE usa VITE_API_BASE_URL=http://localhost:3000/api/v1
API_PREFIX=api/v1
# Aislamiento por tenant en PostgreSQL (RLS): TRES roles. Créelos con prisma/sql/roles.sql ANTES de migrar.
#  · DATABASE_URL         → transportes_app: la API (sin BYPASSRLS; ve solo el tenant de la sesión).
#  · DATABASE_SYSTEM_URL  → transportes_platform: autenticación, plataforma, jobs (BYPASSRLS; solo lectura sobre datos operativos).
#  · MIGRATE_DATABASE_URL → dueño de las tablas: solo `prisma migrate` y la semilla. No lo use la API.
# En producción DATABASE_URL y DATABASE_SYSTEM_URL deben ser roles distintos y la API se niega a arrancar si el rol de la app es superusuario.
DATABASE_URL=postgresql://transportes_app:CHANGE_ME@localhost:5432/transportes?schema=public
DATABASE_SYSTEM_URL=postgresql://transportes_platform:CHANGE_ME@localhost:5432/transportes?schema=public
MIGRATE_DATABASE_URL=postgresql://OWNER:CHANGE_ME@localhost:5432/transportes?schema=public
# Orígenes permitidos (CORS con credenciales para la cookie de refresh), separados por coma.
CORS_ORIGINS=http://localhost:5173
# ADR-003 — secretos de firma: ≥ 32 caracteres aleatorios. Distintos por entorno.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-32-chars-min
FILES_SIGNING_SECRET=change-me-to-another-long-random-secret-32-chars
# Vigencias (SUPUESTO TÉCNICO: DOC-A no fija valores; DOC-G-SEC puede ajustarlos).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=tr_refresh
# true en cualquier entorno servido por HTTPS.
COOKIE_SECURE=false
# Hashing (PasswordHasher/bcrypt): costo.
BCRYPT_COST=12
# Límite de intentos de login por IP y minuto (complementa el bloqueo por cuenta).
AUTH_RATE_LIMIT_PER_MIN=20
# Bloqueo por intentos fallidos (SUPUESTO TÉCNICO).
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
# GAP-009 — umbrales operativos (SUPUESTO TÉCNICO hasta que el negocio los fije).
POSITION_FRESH_SECONDS=90
SIGNAL_LOST_SECONDS=600
DOC_EXPIRING_DAYS=30
SPEED_TOLERANCE_PCT=10
ROUTE_CORRIDOR_METERS=1500
DELAY_TOLERANCE_MINUTES=15
ARRIVAL_ON_TIME_TOLERANCE_MINUTES=15
# Zona de operación por defecto hasta que Principal.timezone esté disponible (FE-CONTRACT-031).
DEFAULT_TIMEZONE=America/Lima
# Almacenamiento de archivos (ADR-009). `local` = disco del servidor, solo desarrollo. El proveedor final lo define DOC-I-OPS.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
PUBLIC_BASE_URL=http://localhost:3000
# Jobs en proceso (sin Redis/BullMQ: no hay decisión de infraestructura). Solo UNA réplica debería tenerlos activos
# o usar el candado consultivo de PostgreSQL que ya aplican los jobs.
# TRUST_PROXY=true cuando la API corre detrás de un proxy/balanceador: sin él, el límite de tasa por IP ve solo la IP del proxy.
TRUST_PROXY=false
JOBS_ENABLED=true
# Swagger/OpenAPI en /api/docs (desactívelo en producción si la política lo exige).
SWAGGER_ENABLED=true
# Tenant de la cartelera pública y de «mi reserva» mientras no exista un enlace público por empresa (PC-A17/PC-A20).
PUBLIC_TENANT_SLUG=
