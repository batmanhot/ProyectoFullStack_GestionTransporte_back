  tenant       Tenant             @relation("ClientProfile_tenantId", fields: [tenantId], references: [id], onDelete: Restrict)
  documentType ClientDocumentType
  document     String
  customer     String
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  @@id([tenantId, documentType, document])
  @@map("client_profile")
}

/// ───────────────────────────── Carga (ENT-017 · PC-A11) ─────────────────────────────

enum CargoStatus {
  REGISTRADA    @map("Registrada")
  ASIGNADA      @map("Asignada")
  EN_TRANSITO   @map("En tránsito")
  ENTREGADA     @map("Entregada")
  CON_EXCEPCION @map("Con excepción")
  CANCELADA     @map("Cancelada")
}

model CargoShipment {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @db.Uuid
  tenant       Tenant             @relation("CargoShipment_tenantId", fields: [tenantId], references: [id], onDelete: Restrict)
  code         String
  documentType ClientDocumentType
  document     String
  customer     String
  cargoType    String
  description  String
  packages     Int
  weightKg     Float
  origin       String
  destination  String
