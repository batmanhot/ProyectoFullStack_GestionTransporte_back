/// ───────────────────────────── Archivos (ADR-009) ─────────────────────────────

enum FileStatus {
  PENDIENTE  @map("Pendiente")
  DISPONIBLE @map("Disponible")
}

/// Metadatos del archivo. El contenido vive en el almacenamiento (puerto `ObjectStorage`); aquí nunca hay binarios ni credenciales.
model StoredFile {
  id                        String               @id @default(uuid(7)) @db.Uuid
  tenantId                  String               @db.Uuid
  tenant                    Tenant               @relation("StoredFile_tenantId", fields: [tenantId], references: [id], onDelete: Restrict)
  name                      String
  size                      Int
  type                      String
  storageKey                String               @unique
  status                    FileStatus           @default(PENDIENTE)
  uploadedBy                String               @db.Uuid
  createdAt                 DateTime             @default(now()) @db.Timestamptz(3)
  completedAt               DateTime?            @db.Timestamptz(3)
  complianceDocumentsByFile ComplianceDocument[] @relation("ComplianceDocument_fileId")

  @@index([tenantId, status])
  @@map("stored_file")
}

/// ───────────────────────────── Notificaciones (ADR-010) ─────────────────────────────

model Notification {
  id         String                 @id @default(uuid(7)) @db.Uuid
  tenantId   String                 @db.Uuid
  tenant     Tenant                 @relation("Notification_tenantId", fields: [tenantId], references: [id], onDelete: Restrict)
  kind       String
  severity   Severity
  title      String
  body       String
  link       String?
  /// Una notificación por clave (p. ej. «subscription.por-vencer.2026-10-01»): repetir la regla no satura la bandeja.
  dedupeKey  String?
  createdAt  DateTime               @default(now()) @db.Timestamptz(3)
  readAt     DateTime?              @db.Timestamptz(3)
  deliveries NotificationDelivery[]

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, createdAt])
  @@map("notification")
}

enum DeliveryStatus {
  ENTREGADA @map("Entregada")
  PENDIENTE @map("Pendiente")
  FALLIDA   @map("Fallida")
}

/// Estado de entrega por canal (≠ estado de gestión). Solo In-app tiene adaptador; Email/Push quedan PENDIENTES de DOC-F-INT.
model NotificationDelivery {
  id             String         @id @default(uuid(7)) @db.Uuid
  notificationId String         @db.Uuid
  notification   Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  status         DeliveryStatus
  attempts       Int            @default(0)
  lastError      String?
  nextAttemptAt  DateTime?      @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("notification_delivery")
}

/// ───────────────────────────── Auditoría (ENT-019 · ADR-011) ─────────────────────────────

enum AuditKind {
  NEGOCIO   @map("Negocio")
  SEGURIDAD @map("Seguridad")
}

/// Append-only: la migración instala un trigger que rechaza UPDATE/DELETE. `before/after` nunca contienen secretos.
model AuditEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  at            DateTime  @default(now()) @db.Timestamptz(3)
  kind          AuditKind
  tenantId      String?   @db.Uuid
  actorUserId   String?   @db.Uuid
  actor         String
  actorRoles    String[]
  resourceType  String
  resourceId    String
  action        String
  result        String    @default("OK")
  reason        String?
  before        String?
  after         String?
  correlationId String
  ip            String?
  userAgent     String?

  @@index([tenantId, at(sort: Desc), id(sort: Desc)])
  @@index([tenantId, resourceType, resourceId, at])
  @@index([action, at])
  @@map("audit_event")
}

/// ───────────────────────────── Transversal ─────────────────────────────

/// Idempotencia (ADR-002): misma clave + misma intención ⇒ misma respuesta; otra intención ⇒ IDEMPOTENCY_CONFLICT.
model IdempotencyRecord {
  id          String   @id @default(uuid(7)) @db.Uuid
  scopeKey    String   @unique
  requestHash String
  status      String
  httpStatus  Int?
  response    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_record")
}

/// Ejecuciones de jobs (señal de observabilidad para la consola de plataforma).
model JobRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  job        String
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  status     String
  detail     String?

  @@index([job, startedAt])
  @@map("job_run")
}
